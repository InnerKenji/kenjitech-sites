# Base PostgreSQL (Neon). Fournie automatiquement par l'intégration Vercel/Neon.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Clé maître (32 octets en base64) qui chiffre les clés secrètes des postes.
MASTER_KEY=
# Secret des sessions web (32 octets en base64).
SESSION_SECRET=
# Clé privée X25519 (base64) qui déchiffre les codes d'activation. La clé publique est dans le logiciel.
ACTIVATION_SECRET_KEY=
# Jeton à usage unique pour créer le premier compte super admin (/admin/setup).
SETUP_TOKEN=
